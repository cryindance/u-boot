digraph Memory_Layout {
    // 图设置
    rankdir=LR;
    node [shape=record, fontname="Arial", fontsize=10];
    edge [style=invis];
    
    // 内存区域定义
    Memory [label="<>地址空间|{0x8000_0000|SPL_TEXT_BASE\n(加载地址)|{|u-boot-spl.bin|代码段 .text|只读数据 .rodata|数据段 .data|符号表 .binman_sym|_end (DTB位置)|{.bss|未初始化数据}|}}|{0x8004_0000|SPL_BSS区域结束|{|...|可用内存|}}|{0xC000_0000|SPL_OPENSBI_LOAD_ADDR|{|opensbi.bin\n(OpenSBI固件)|}}|{0xC300_0000|fit_addr|{|kernel.itb\n(FIT格式)|kernel + ramdisk|}}|{0xC800_0000|fdt_addr|{|dtb\n(设备树)|}}}", 
           fillcolor="#f5f5f5", style=filled];
    
    // 颜色标注
    spl [label="SPL区域\n(64-256KB)", shape=box, fillcolor="#bbdefb", style=filled];
    opensbi [label="OpenSBI", shape=box, fillcolor="#c8e6c9", style=filled];
    fit [label="FIT镜像", shape=box, fillcolor="#fff9c4", style=filled];
    dtb [label="DTB", shape=box, fillcolor="#ffccbc", style=filled];
    
    // 布局
    {rank=same; spl; Memory}
    
    // 标题
    labelloc="t";
    label="Nuclei SPL 内存布局";
    fontsize=14;
    fontname="Arial Bold";
}
